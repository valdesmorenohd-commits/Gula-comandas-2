// Gula Comandas 2.0 — REGLAS BASE BLOQUEADAS (NO DESPLEGADAS)
// No habilitar lecturas ni escrituras desde el navegador hasta implementar
// roles verificados y transacciones compatibles con los invariantes del POS.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
