// Gula Comandas 2.0: membresías RESTRINGIDAS, fase de pruebas.
// NO desplegado. Ningún módulo comercial dispone de lecturas/escrituras.
// Alta inicial del administrador principal: solo por Firebase Console o
// entorno privilegiado seguro; jamás desde el navegador.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function loggedIn() {
      return request.auth != null;
    }
    function memberPath(businessId, uid) {
      return /databases/$(database)/documents/businesses/$(businessId)/members/$(uid);
    }
    function isPrincipal(businessId) {
      return loggedIn()
        && exists(memberPath(businessId, request.auth.uid))
        && get(memberPath(businessId, request.auth.uid)).data.active == true
        && get(memberPath(businessId, request.auth.uid)).data.roleId == 'principal_admin';
    }
    function validStaffMember(data, businessId, uid) {
      return data.keys().hasOnly([
          'uid', 'businessId', 'name', 'email', 'roleId', 'active',
          'grants', 'denies', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasAll([
          'uid', 'businessId', 'name', 'email', 'roleId', 'active',
          'grants', 'denies', 'updatedAt', 'updatedBy'
        ])
        && data.uid == uid
        && data.businessId == businessId
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.email is string && data.email.size() <= 160
        && data.roleId in ['personal', 'consulta']
        && data.active is bool
        && data.grants is list && data.grants.size() <= 15
        && data.denies is list && data.denies.size() <= 15
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }
    match /businesses/{businessId}/members/{uid} {
      allow get: if loggedIn() && (request.auth.uid == uid || isPrincipal(businessId));
      allow list: if isPrincipal(businessId);
      // Sólo administrador principal activo; nunca se modifica a sí mismo.
      // Se prohíbe crear/modificar otros administradores desde la web.
      allow create: if isPrincipal(businessId)
        && uid != request.auth.uid
        && validStaffMember(request.resource.data, businessId, uid);
      allow update: if isPrincipal(businessId)
        && uid != request.auth.uid
        && resource.data.roleId in ['personal','consulta']
        && validStaffMember(request.resource.data, businessId, uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name','email','roleId','active','grants','denies','updatedAt','updatedBy'
        ]);
      allow delete: if false;
    }
    // Preparación del núcleo de ventas: sin activar aún la interfaz.
    // Las fichas se validan por pertenencia activa; el backend tendrá que
    // verificar totales, inventario y pagos antes de operar con ventas reales.
    function activeMember(businessId) {
      return loggedIn()
        && exists(memberPath(businessId, request.auth.uid))
        && get(memberPath(businessId, request.auth.uid)).data.active == true;
    }
    function canCreateOrder(businessId) {
      return activeMember(businessId)
        && get(memberPath(businessId, request.auth.uid)).data.roleId in ['principal_admin','personal'];
    }
    function orderFieldsValid(data,businessId) {
      return data.keys().hasOnly([
          'businessId','customer','deliveryDate','deliveryWindow','items',
          'notes','status','paymentStatus','createdBy','createdAt',
          'updatedBy','updatedAt','schemaVersion'
        ])
        && data.keys().hasAll([
          'businessId','customer','deliveryDate','deliveryWindow','items',
          'notes','status','paymentStatus','createdBy','createdAt',
          'updatedBy','updatedAt','schemaVersion'
        ])
        && data.schemaVersion == 1
        && data.businessId == businessId
        && data.customer is string && data.customer.size() >= 1 && data.customer.size() <= 100
        && data.deliveryDate is string && data.deliveryDate.size() == 10
        && data.deliveryWindow is string && data.deliveryWindow.size() <= 100
        && data.notes is string && data.notes.size() <= 1500
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 30
        && data.status in ['open','canceled','closed']
        && data.paymentStatus in ['pending','partial','paid']
        && data.createdBy is string
        && data.createdAt is timestamp
        && data.updatedBy is string && data.updatedAt is timestamp;
    }
    match /businesses/{businessId}/orders/{orderId} {
      allow get, list: if activeMember(businessId);
      // Únicamente los datos preparatorios sin importes ni movimiento de caja.
      // No se autoriza editar, cerrar, cobrar ni anular desde la web.
      allow create: if canCreateOrder(businessId)
        && orderFieldsValid(request.resource.data,businessId)
        && request.resource.data.status == 'open'
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;
    }
    // Las otras colecciones siguen sin acceso. No desplegar hasta validar.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
