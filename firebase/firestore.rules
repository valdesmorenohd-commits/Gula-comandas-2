// Gula Comandas 2.0: membresías RESTRINGIDAS, fase de pruebas.
// NO desplegado. Ningún módulo comercial dispone de lecturas/escrituras.
// Alta inicial del administrador principal: solo por Firebase Console o
// entorno privilegiado seguro; jamás desde el navegador.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function loggedIn() {
      return request.auth != null;
    }
    function memberPath(businessId, uid) {
      return /databases/$(database)/documents/businesses/$(businessId)/members/$(uid);
    }
    function isPrincipal(businessId) {
      return loggedIn()
        && exists(memberPath(businessId, request.auth.uid))
        && get(memberPath(businessId, request.auth.uid)).data.active == true
        && get(memberPath(businessId, request.auth.uid)).data.roleId == 'principal_admin';
    }
    function validStaffMember(data, businessId, uid) {
      return data.keys().hasOnly([
          'uid', 'businessId', 'name', 'email', 'roleId', 'active',
          'grants', 'denies', 'updatedAt', 'updatedBy'
        ])
        && data.keys().hasAll([
          'uid', 'businessId', 'name', 'email', 'roleId', 'active',
          'grants', 'denies', 'updatedAt', 'updatedBy'
        ])
        && data.uid == uid
        && data.businessId == businessId
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 80
        && data.email is string && data.email.size() <= 160
        && data.roleId in ['personal', 'consulta']
        && data.active is bool
        && data.grants is list && data.grants.size() <= 15
        && data.denies is list && data.denies.size() <= 15
        && data.updatedBy == request.auth.uid
        && data.updatedAt == request.time;
    }
    match /businesses/{businessId}/members/{uid} {
      allow get: if loggedIn() && (request.auth.uid == uid || isPrincipal(businessId));
      allow list: if isPrincipal(businessId);
      // Sólo administrador principal activo; nunca se modifica a sí mismo.
      // Se prohíbe crear/modificar otros administradores desde la web.
      allow create: if isPrincipal(businessId)
        && uid != request.auth.uid
        && validStaffMember(request.resource.data, businessId, uid);
      allow update: if isPrincipal(businessId)
        && uid != request.auth.uid
        && resource.data.roleId in ['personal','consulta']
        && validStaffMember(request.resource.data, businessId, uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name','email','roleId','active','grants','denies','updatedAt','updatedBy'
        ]);
      allow delete: if false;
    }
    // Los borradores no afectan inventario ni caja; no equivalen a ventas.
    // Las fichas se validan por pertenencia activa; el backend tendrá que
    // verificar totales, inventario y pagos antes de operar con ventas reales.
    function activeMember(businessId) {
      return loggedIn()
        && exists(memberPath(businessId, request.auth.uid))
        && get(memberPath(businessId, request.auth.uid)).data.active == true;
    }
    function canCreateOrder(businessId) {
      return activeMember(businessId)
        && get(memberPath(businessId, request.auth.uid)).data.roleId in ['principal_admin','personal'];
    }
    function orderFieldsValid(data,businessId) {
      return data.keys().hasOnly([
          'businessId','customer','deliveryDate','deliveryWindow','items',
          'notes','status','paymentStatus','createdBy','createdAt',
          'updatedBy','updatedAt','schemaVersion'
        ])
        && data.keys().hasAll([
          'businessId','customer','deliveryDate','deliveryWindow','items',
          'notes','status','paymentStatus','createdBy','createdAt',
          'updatedBy','updatedAt','schemaVersion'
        ])
        && data.schemaVersion == 1
        && data.businessId == businessId
        && data.customer is string && data.customer.size() >= 1 && data.customer.size() <= 100
        && data.deliveryDate is string && data.deliveryDate.size() == 10
        && data.deliveryWindow is string && data.deliveryWindow.size() <= 100
        && data.notes is string && data.notes.size() <= 1500
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 30
        && data.status in ['open','canceled','closed']
        && data.paymentStatus in ['pending','partial','paid']
        && data.createdBy is string
        && data.createdAt is timestamp
        && data.updatedBy is string && data.updatedAt is timestamp;
    }
    match /businesses/{businessId}/draftOrders/{orderId} {
      allow get, list: if activeMember(businessId);
      // Únicamente los datos preparatorios sin importes ni movimiento de caja.
      // No se autoriza editar, cerrar, cobrar ni anular desde la web.
      allow create: if canCreateOrder(businessId)
        && orderFieldsValid(request.resource.data,businessId)
        && request.resource.data.status == 'open'
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update, delete: if false;
    }
    // Los datos de ventas definitivas se escriben exclusivamente con
    // Cloud Functions (Admin SDK en servidor), nunca directamente desde cliente.
    match /businesses/{businessId}/orders/{orderId} {
      allow get, list: if activeMember(businessId);
      allow create, update, delete: if false;
    }
    match /businesses/{businessId}/cashEntries/{movementId} {
      allow get, list: if isPrincipal(businessId);
      allow create, update, delete: if false;
    }
    match /businesses/{businessId}/inventory/{inventoryId} {
      allow get, list: if activeMember(businessId);
      allow create, update, delete: if false;
    }
    match /businesses/{businessId}/audit/{eventId} {
      allow get, list: if isPrincipal(businessId);
      allow create, update, delete: if false;
    }
    match /businesses/{businessId}/cashClosures/{day} {
      allow get, list: if isPrincipal(businessId);
      allow create, update, delete: if false;
    }
    // Contadores y registro de operaciones son indispensables para recuperar
    // numeración y evitar repetir cobros al restaurar datos. Solo lectura del
    // administrador principal: toda modificación pasa por el servidor.
    match /businesses/{businessId}/counters/{counterId} {
      allow get, list: if isPrincipal(businessId);
      allow create, update, delete: if false;
    }
    match /businesses/{businessId}/operations/{operationId} {
      allow get, list: if isPrincipal(businessId);
      allow create, update, delete: if false;
    }
    // Catálogo compartido: las existencias NO se ajustan desde esta colección.
    // Solo el administrador principal edita los precios y el catálogo.
    function productValid(data,businessId) {
      return data.keys().hasAll(['businessId','name','category','price','active','stockMode','photoUrl','createdAt','createdBy','updatedAt','updatedBy','schemaVersion'])
        && data.keys().hasOnly(['businessId','name','category','price','options','active','stockMode','photoUrl','createdAt','createdBy','updatedAt','updatedBy','schemaVersion'])
        && data.businessId == businessId
        && data.schemaVersion == 1
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.category is string && data.category.size() <= 80
        && data.price is int && data.price >= 0 && data.price <= 10000000
        && data.active is bool
        && (!data.keys().hasAny(['options']) || (data.options is list && data.options.size() <= 20))
        && data.stockMode in ['permanent','dated']
        && data.photoUrl is string && data.photoUrl.size() <= 500
        && data.createdAt is timestamp
        && data.createdBy is string
        && data.updatedAt is timestamp
        && data.updatedBy == request.auth.uid;
    }
    match /businesses/{businessId}/products/{productId} {
      allow get, list: if activeMember(businessId);
      allow create: if isPrincipal(businessId)
        && productValid(request.resource.data,businessId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isPrincipal(businessId)
        && productValid(request.resource.data,businessId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name','category','price','options','active','stockMode','photoUrl','updatedAt','updatedBy'
        ]);
      allow delete: if false;
    }
    // Clientes compartidos. Los cambios están limitados a personal y principal.
    function clientValid(data,businessId) {
      return data.keys().hasAll(['businessId','name','phone','notes','createdAt','createdBy','updatedAt','updatedBy','schemaVersion'])
        && data.keys().hasOnly(['businessId','name','phone','notes','createdAt','createdBy','updatedAt','updatedBy','schemaVersion'])
        && data.businessId == businessId
        && data.schemaVersion == 1
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.phone is string && data.phone.size() <= 30
        && data.notes is string && data.notes.size() <= 500
        && data.createdAt is timestamp
        && data.createdBy is string
        && data.updatedAt is timestamp
        && data.updatedBy == request.auth.uid;
    }
    match /businesses/{businessId}/clients/{clientId} {
      allow get, list: if activeMember(businessId);
      allow create: if canCreateOrder(businessId)
        && clientValid(request.resource.data,businessId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if canCreateOrder(businessId)
        && clientValid(request.resource.data,businessId)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name','phone','notes','updatedAt','updatedBy'
        ]);
      allow delete: if false;
    }
    // Las otras colecciones siguen sin acceso. No desplegar hasta validar.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
